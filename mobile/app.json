{
  "expo": {
    "name": "Appunti Vocali",
    "slug": "voice-notes-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yurymenichelli.voicenotes",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "L'app ascolta la parola \"appunta\" per registrare i tuoi appunti vocali, anche quando è in background.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "L'app ascolta la parola \"appunta\" per registrare i tuoi appunti vocali."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "L'app ascolta la parola \"appunta\" per registrare i tuoi appunti vocali.",
          "speechRecognitionPermission": "L'app usa il riconoscimento vocale del telefono per capire quando dici \"appunta\"."
        }
      ]
    ]
  }
}
